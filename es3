        <div class="form-group">
            <label>Sport Praticati:</label>
            <div class="radio-check-group">
                <input type="checkbox" id="sport1" name="sport" value="Calcio"> <label for="sport1">Calcio</label>
                <input type="checkbox" id="sport2" name="sport" value="Basket"> <label for="sport2">Basket</label>
                <input type="checkbox" id="sport3" name="sport" value="Tennis"> <label for="sport3">Tennis</label>
                <input type="checkbox" id="sport4" name="sport" value="Nuoto"> <label for="sport4">Nuoto</label>
                <input type="checkbox" id="sport5" name="sport" value="Pallavolo"> <label for="sport5">Pallavolo</label>
                <input type="checkbox" id="sport6" name="sport" value="Atletica"> <label for="sport6">Atletica</label>
            </div>
        </div>
        <div class="form-group">
            <label for="commenti">Commenti:</label>
            <textarea id="commenti" name="commenti" rows="4" placeholder="Inserisci eventuali note..."></textarea>
        </div>
        
        <button type="submit">Genera Tabella</button>
    </form>
    <table id="tabellaRisultati">
        <thead>
            <tr>
                <th>Campo</th>
                <th>Dato Inserito</th>
            </tr>
        </thead>
        <tbody id="corpoTabella">
        </tbody>
    </table>
    <script>
        document.getElementById('dataForm').addEventListener('submit', function(e) {
            e.preventDefault(); 
            const nome = document.getElementById('nome').value;
            const cognome = document.getElementById('cognome').value;
            const eta = document.getElementById('eta').value;
            const sessoChecked = document.querySelector('input[name="sesso"]:checked');
            const sesso = sessoChecked ? sessoChecked.value : 'Non specificato';
            const indirizzo = document.getElementById('indirizzo').value;
            const citta = document.getElementById('citta').value;
            const provincia = document.getElementById('provincia').value;
            const commenti = document.getElementById('commenti').value || 'Nessun commento';
            const sportSelezionati = document.querySelectorAll('input[name="sport"]:checked');
            let sport = [];
            sportSelezionati.forEach((checkbox) => {
                sport.push(checkbox.value);
            });
            const sportStr = sport.length > 0 ? sport.join(', ') : 'Nessuno sport selezionato';
            const dati = [
                { etichetta: 'Nome', valore: nome },
                { etichetta: 'Cognome', valore: cognome },
                { etichetta: 'Età', valore: eta },
                { etichetta: 'Sesso', valore: sesso },
                { etichetta: 'Indirizzo', valore: indirizzo },
                { etichetta: 'Città', valore: citta },
                { etichetta: 'Provincia', valore: provincia },
                { etichetta: 'Sport Praticati', valore: sportStr },
                { etichetta: 'Commenti', valore: commenti }
            ];
            const corpoTabella = document.getElementById('corpoTabella');
            corpoTabella.innerHTML = ''; 
            dati.forEach(elemento => {
                const tr = document.createElement('tr');
                const tdEtichetta = document.createElement('td');
                tdEtichetta.textContent = elemento.etichetta;
                tdEtichetta.style.fontWeight = 'bold';
 
                const tdValore = document.createElement('td');
                tdValore.textContent = elemento.valore;

                tr.appendChild(tdEtichetta);
                tr.appendChild(tdValore);
                corpoTabella.appendChild(tr);
            });
            document.getElementById('tabellaRisultati').style.display = 'table';
        });
    </script>
</body>
</html>
