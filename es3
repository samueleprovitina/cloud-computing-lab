<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Maschera di Inserimento Dati</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 20px auto; line-height: 1.5; }
        .form-group { margin-bottom: 15px; }
        label { display: inline-block; width: 140px; vertical-align: top; font-weight: bold; }
        input[type="text"], input[type="number"], select, textarea { width: 250px; padding: 6px; }
        .radio-check-group { display: inline-block; width: calc(100% - 150px); }
        .radio-check-group label { width: auto; font-weight: normal; margin-right: 15px; cursor: pointer; }
        
        table { border-collapse: collapse; width: 100%; margin-top: 30px; display: none; }
        th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
        th { background-color: #f4f4f4; width: 35%; }
        
        button { padding: 8px 16px; font-size: 15px; cursor: pointer; background-color: #007bff; color: white; border: none; border-radius: 4px; }
        button:hover { background-color: #0056b3; }
    </style>
</head>
<body>

    <h2>Inserimento Dati Utente</h2>
    <form id="dataForm">
        <div class="form-group">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" required>
        </div>
        
        <div class="form-group">
            <label for="cognome">Cognome:</label>
            <input type="text" id="cognome" name="cognome" required>
        </div>
        
        <div class="form-group">
            <label for="eta">Età:</label>
            <input type="number" id="eta" name="eta" min="1" max="120" required>
        </div>  
        <div class="form-group">
            <label>Sesso:</label>
            <div class="radio-check-group">
                <input type="radio" id="sessoM" name="sesso" value="Maschio" required> <label for="sessoM">Maschio</label>
                <input type="radio" id="sessoF" name="sesso" value="Femmina"> <label for="sessoF">Femmina</label>
                <input type="radio" id="sessoND" name="sesso" value="Non specificato"> <label for="sessoND">Altro / Non specificato</label>
            </div>
        </div>      
        <div class="form-group">
            <label for="indirizzo">Indirizzo:</label>
            <input type="text" id="indirizzo" name="indirizzo" required>
        </div>
        <div class="form-group">
            <label for="citta">Città:</label>
            <input type="text" id="citta" name="citta" required>
        </div>
